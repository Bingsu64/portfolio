  (text "ORing MosFET" (at 242.57 22.86 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid 05fc76dd-daa8-4f79-bbcf-69d011b69eec)
  )
  (text "ORing Diodes" (at 121.92 22.86 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid 2fc1e6a5-311d-4490-a28b-236681cf63c2)
  )
  (text "Could alleviate burden on main batteries.\nHardcode solution in case components within PSU\ncreate too much heat or are deemed unreliable.\nCan be combined with other redundancy solutions.\n"
    (at 20.32 137.16 0)
    (effects (font (size 2 2)) (justify left bottom))
    (uuid 46191098-3ddf-44be-8eac-7204e968ba39)
  )
  (text "Using MOSFET's instead of diodes reduces waste heat.\nHowever, in need of control signal and no protection from load side.\nAdditional control module takes up space.\n\nPossible controllers like LT4351 also provide\nUV and OV shutoff protection based on hysteresis\nwith low pass filters to neglect pulses"
    (at 165.1 99.06 0)
    (effects (font (size 2 2)) (justify left bottom))
    (uuid a397a70b-10ea-4d6d-805c-a86307d125d0)
  )
  (text "Simple, Cheap and Compact.\nProtects from Batteryside Faults and Reverse Polarity.\nHowever, high potential for waste heat accumulation\nduring nominal, stress situations and failures on load side."
    (at 20.32 71.12 0)
    (effects (font (size 2 2)) (justify left bottom))
    (uuid ad5d3d0f-f587-4982-86e5-04f69bf40d48)
  )
  (text "SELECTED" (at 209.55 161.29 0)
    (effects (font (size 4 4) bold (color 255 0 6 1)) (justify left bottom))
    (uuid b139083a-904c-4a15-b524-8b3198aa8f43)
  )
  (text "Backup Battery" (at 121.92 82.55 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid cf153602-c210-4d44-88c3-c206d0ed067a)
  )

